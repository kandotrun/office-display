[Unit]
Description=Honeypot live view mux for the 2F display (survey + attack dashboard)
After=network-online.target room-survey.service
Wants=network-online.target

[Service]
Type=simple
User=tsuqrea
Environment=HONEYPOT_PORT=8097
Environment=HONEYPOT_DATA_URL=http://192.168.80.123:8902/status.json
Environment=HONEYPOT_SURVEY_PORT=8094
Environment=HONEYPOT_CUTIN_EVERY=180
Environment=HONEYPOT_CUTIN_SECONDS=30
ExecStart=@PYTHON@ -u @HOME@/honeypot/honeypot_view.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
